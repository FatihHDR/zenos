# Qdrant Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=zenos_docs
# Set QDRANT_USE_LOCAL_MEMORY=false to connect to docker/remote Qdrant, or true for embedded in-memory mode (useful for lightweight testing)
QDRANT_USE_LOCAL_MEMORY=false

# Embedding Configuration
DENSE_MODEL_NAME=BAAI/bge-m3
SPARSE_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Chunking Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=100

# Phase 3: Reranking (25 RRF candidates -> top 5)
# RERANK_PROVIDER: auto | cohere | local (auto = Cohere if COHERE_API_KEY is set, else local cross-encoder)
RERANK_PROVIDER=auto
RERANK_TOP_N=5
RETRIEVAL_CANDIDATES=25
RERANK_LOCAL_MODEL=BAAI/bge-reranker-v2-m3
# COHERE_API_KEY=your_cohere_api_key
COHERE_RERANK_MODEL=rerank-multilingual-v3.0

# Phase 3: Grounded generation (Claude)
# ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANSWER_TEMPERATURE=0.0
ANSWER_MAX_TOKENS=1024
